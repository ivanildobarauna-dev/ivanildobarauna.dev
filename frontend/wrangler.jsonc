{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ivanildobarauna-dev",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "images": {
    "binding": "IMAGES"
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/assets/*",
      "/images/*",
      "/data/*"
    ]
  },
  "routes": [
    {
      "pattern": "ivanildobarauna.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
